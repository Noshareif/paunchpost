# Copy these into Vercel → Project → Settings → Environment Variables.
# Never commit real values.

# Sign-in for PaunchPost until Microsoft 365 login is added
APP_USER=noah
APP_PASSWORD=choose-a-long-password

# AWS (the upload-only user from the setup guide)
AWS_REGION=us-east-2
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
S3_BUCKET=paunchpost-images

# Where images are served from. Use the CloudFront address until images.darkhorsetech.com is set up.
IMAGES_BASE_URL=https://images.darkhorsetech.com
