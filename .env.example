# Copy these into Vercel → Project → Settings → Environment Variables. Never commit real values.

# Sign-in for PaunchPost until Microsoft 365 login is added
APP_USER=noah
APP_PASSWORD=choose-a-long-password

# Database: set automatically when you connect Neon in Vercel → Storage
DATABASE_URL=

# The site's public address (used in tracking and unsubscribe links)
APP_URL=https://paunchpost.vercel.app

# Amazon SES sending (keys for the send-only AWS user; paste straight into Vercel)
# Vercel sets AWS_REGION to its own server region, so SES uses SES_REGION (default us-east-2)
SES_REGION=us-east-2
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
SES_CONFIGURATION_SET=paunchpost
SES_RATE_PER_SECOND=12

# Optional: generated automatically from the database password if left out
# CRON_SECRET=
# SES_WEBHOOK_KEY=
